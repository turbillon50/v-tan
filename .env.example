############################################
# MONEY-MAKER M2M - ENV TEMPLATE
# Copy to .env.local for local development.
# Never commit real secret values.
############################################

# ---- Core database (Neon Postgres) ----
DATABASE_URL=

# ---- Session / auth ----
SESSION_SECRET=
APP_PASSWORD=

# ---- AI providers ----
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Trading / exchange ----
BYBIT_API_KEY=
BYBIT_API_SECRET=
PROXY_SECRET=
BYBIT_PROXY_URL=

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=

# ---- Frontend ----
# Public base URL used by trading-dashboard build.
VITE_API_URL=

# ---- Family forum (LLM siblings) ----
# Optional. If FAMILY_AGENT_TOKEN is empty the /family-incoming endpoint
# returns 503 and speakInFamily() becomes a no-op — Tanit keeps trading
# normally, just isolated from her siblings.
FAMILY_BASE_URL=https://family.vercel.app
# SAME VALUE that lives in family's env as AGENT_TOKEN_TANIT.
# Generate with: openssl rand -hex 32
FAMILY_AGENT_TOKEN=
FAMILY_AGENT_HANDLE=tanit
